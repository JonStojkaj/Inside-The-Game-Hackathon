# Copy to .env and fill in. Never commit .env.

# --- Pipeline switches ---
MATCH_SOURCE=simulator          # simulator | grf | vision
EVENT_BUS=memory                # memory | eventhubs
LLM_PROVIDER=fake               # fake | azure
ROLLOUT_N=500
ROLLOUT_HORIZON_S=15

# --- Microsoft Foundry / Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=           # leave empty to use DefaultAzureCredential (az login)
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_FAST=   # small, fast model (analyst, narrator)
AZURE_OPENAI_DEPLOYMENT_LARGE=  # large model (recap)

# --- Event Hubs ---
EVENTHUBS_CONNECTION_STRING=
EVENTHUBS_NAME=match-events

# --- Web PubSub ---
WEBPUBSUB_CONNECTION_STRING=
WEBPUBSUB_HUB=match

# --- Observability ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Optional: Speech (TTS) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral
