{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=swedencentral}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP=rg-slidingdoors}"
    },
    "webExists": {
      "value": "${SERVICE_WEB_RESOURCE_EXISTS=false}"
    },
    "minReplicas": {
      "value": "${MIN_REPLICAS=0}"
    },
    "askEnabled": {
      "value": "${ASK_ENABLED=true}"
    },
    "openAiName": {
      "value": "${AZURE_OPENAI_NAME=sllidingdoors-ai-js}"
    },
    "openAiResourceGroup": {
      "value": "${AZURE_OPENAI_RESOURCE_GROUP=rg-j.stojkaj-6522}"
    },
    "openAiEndpoint": {
      "value": "${AZURE_OPENAI_ENDPOINT=https://sllidingdoors-ai-js.openai.azure.com/openai/v1/}"
    },
    "openAiDeploymentFast": {
      "value": "${AZURE_OPENAI_DEPLOYMENT_FAST=fast}"
    },
    "speechKey": {
      "value": "${AZURE_SPEECH_KEY=}"
    },
    "speechRegion": {
      "value": "${AZURE_SPEECH_REGION=swedencentral}"
    }
  }
}
